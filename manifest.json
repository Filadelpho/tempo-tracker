{
  "manifest_version": 3,
  "name": "Tempo Tracker",
  "version": "0.6.0",
  "description": "Mostra quanto tempo você passa em cada site, pra fechar o dia mais produtiva.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "storage",
    "idle",
    "alarms",
    "notifications",
    "favicon",
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "utils.js",
        "widget/cronometro.js",
        "widget/widget.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Tempo Tracker",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options/options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "externally_connectable": {
    "ids": []
  }
}
